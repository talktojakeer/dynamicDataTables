<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Groups Insight Card</masterLabel>
    <description>Insight card showing counts of Recruit Class and FTU Group accounts, with a New button to create one. Refreshes on create.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage,lightning__RecordPage">
            <property name="cardTitle"        type="String"  label="Card Title"           default="Groups Overview"/>
            <property name="buttonLabel"      type="String"  label="Button Label"          default="New"/>
            <property name="recruitTileLabel" type="String"  label="Recruit Tile Label"    default="Recruit Class Accounts"/>
            <property name="ftuTileLabel"     type="String"  label="FTU Tile Label"        default="FTU Group Accounts"/>
            <property name="showIcon"         type="Boolean" label="Show Header Icon"      default="false"/>
            <property name="iconName"         type="String"  label="Header Icon Name"      default="standard:groups"/>
            <!-- Retained: pages Create_Groups_Home_Page / Create_Groups reference this.
                 Kept for backward compatibility (no longer used by the component). -->
            <property name="hideCard"         type="Boolean" label="Button Only (no card)" default="false"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>