<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Create Group</masterLabel>
    <description>Create a Recruit Class or FTU Group.</description>
    <targets>
        <!-- Record page quick action / button -->
        <target>lightning__RecordAction</target>
        <!-- Lightning App Builder: App, Home and Record pages -->
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
        <!-- Flow screens -->
        <target>lightning__FlowScreen</target>
    </targets>

    <targetConfigs>
        <targetConfig targets="lightning__RecordAction">
            <actionType>Action</actionType>
        </targetConfig>

        <!-- Flow: expose the created group's Id as an output the Flow can use -->
        <targetConfig targets="lightning__FlowScreen">
            <property name="newAccountId"
                      type="String"
                      label="Created Group Id"
                      role="outputOnly"
                      description="Id of the Recruit Class / FTU Group that was created."/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>