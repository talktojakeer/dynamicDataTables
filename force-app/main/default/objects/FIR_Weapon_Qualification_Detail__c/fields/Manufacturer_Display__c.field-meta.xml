<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Manufacturer_Display__c</fullName>
    <description>Clean manufacturer name without the weapon-type suffix. Use this in reports/PDF instead of Manufacturer__c.</description>
    <externalId>false</externalId>
    <formula>IF(CONTAINS(TEXT(Manufacturer__c), &quot; (&quot;), LEFT(TEXT(Manufacturer__c), FIND(&quot; (&quot;, TEXT(Manufacturer__c)) - 1), TEXT(Manufacturer__c))</formula>
    <label>Manufacturer (Display)</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
