<apex:page standardController="FIR_Qualification_Form__c"
           extensions="FIRQualificationFormControllerExt"
           sidebar="false" showHeader="false"
           renderAs="{!IF($CurrentPage.parameters.html == '1', '', 'pdf')}"
           applyBodyTag="false" applyHtmlTag="false">
<head>
<style type="text/css">
    @page { size: A4 portrait; margin: 1.0cm; }
    body, td, th { font-family: Arial, Helvetica, sans-serif; font-size: 8px; line-height: 1.15; color: #000; }
    h1 { font-size: 13px; text-align: center; margin: 0; font-weight: bold; }
    h2 { font-size: 12px; text-align: center; margin: 0 0 6px 0; font-weight: bold; }
    .lbl { font-weight: bold; }
    .center { text-align: center; }
    .legend { font-size: 6.5px; }
    .section-table { width: 100%; border-collapse: collapse; margin-bottom: 4px; }
    .section-box { border: 1px solid #000; padding: 4px 6px; min-height: 43px; }
    .sectitle { font-weight: bold; text-align: center; background: #e5e5e5; border: 1px solid #000; padding: 2px; }
    .info-grid { width: 100%; border-collapse: collapse; }
    .info-grid td { padding: 2px 6px 2px 0; vertical-align: top; width: 50%; }
    .grid { width: 100%; border-collapse: collapse; }
    .grid th, .grid td { border: 1px solid #000; padding: 2px 3px; vertical-align: top; }
    .name-inline { padding-top: 2px; }
    .signature-image { width: 100%; height: 50px; border-bottom: 1px solid #000; overflow: hidden; position: relative; }
    .signature-image img { display: block !important; width: auto !important; height: 40px !important; max-width: 90% !important; max-height: 40px !important; margin: 0 !important; padding: 0 !important; }
    .date-line { height: 28px; border-bottom: 1px solid #000; padding-top: 2px; }
    .footer { font-size: 7px; text-align: center; }
</style>
</head>
<body>

    <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:12px;">
        <tr>
            <td width="11%" valign="middle" style="padding-right:12px;">
                <img src="{!$Resource.FaqpDpsLogo}" style="width:1.2in;height:1.2in;"/>
            </td>
            <td valign="middle">
                <div style="font-size:24px; font-weight:bold; font-family:Arial,sans-serif; margin:0;">Texas Department of Public Safety</div>
                <div style="font-size:24px; font-weight:bold; font-family:Arial,sans-serif; margin:3px 0 0 0;">Firearms Qualification Report</div>
            </td>
        </tr>
    </table>

    <apex:outputPanel rendered="{!NOT(FIR_Qualification_Form__c.ContactName__r.FAQP_Is_Retired_Officer__c)}" layout="block">
        <table class="section-table">
            <tr>
                <td style="width:100%;">
                    <div class="sectitle">Active Employee</div>
                    <div class="section-box">
                        <table class="info-grid">
                            <tr>
                                <td><span class="lbl">Full Legal Name:</span> <apex:outputText value="{!FIR_Qualification_Form__c.ContactName__r.Name}"/></td>
                                <td><span class="lbl">Light Condition:</span> <apex:outputText value="{!FIR_Qualification_Form__c.Light_Condition__c}"/></td>
                            </tr>
                            <tr>
                                <td><span class="lbl">Employee TINS:</span> <apex:outputText value="{!FIR_Qualification_Form__c.ContactName__r.FAQP_TINS_NUMBER__c}"/></td>
                                <td><span class="lbl">Division:</span> <apex:outputText value="{!FIR_Qualification_Form__c.ContactName__r.FAQP_Division__c}"/></td>
                            </tr>
                            <tr>
                                <td><span class="lbl">Region:</span> <apex:outputText value="{!FIR_Qualification_Form__c.ContactName__r.FAQP_Region__c}"/></td>
                                <td><span class="lbl">Firearms Instructor:</span> <apex:outputText value="{!IF(FIR_Qualification_Form__c.ContactName__r.Is_Firearms_Instructor__c, 'Yes', 'No')}"/></td>
                            </tr>
                        </table>
                    </div>
                </td>
            </tr>
        </table>
    </apex:outputPanel>

    <apex:outputPanel rendered="{!FIR_Qualification_Form__c.ContactName__r.FAQP_Is_Retired_Officer__c}" layout="block">
        <table class="section-table">
            <tr>
                <td style="width:100%;">
                    <div class="sectitle">Retired Peace Officer</div>
                    <div class="section-box">
                        <table class="info-grid">
                            <tr>
                                <td><span class="lbl">Full Legal Name:</span> <apex:outputText value="{!FIR_Qualification_Form__c.ContactName__r.Name}"/></td>
                                <td><span class="lbl">Light Condition:</span> <apex:outputText value="{!FIR_Qualification_Form__c.Light_Condition__c}"/></td>
                            </tr>
                            <tr>
                                <td>
                                    <span class="lbl">Year Retired:</span>
                                    <apex:outputText value="{0,date,MM/dd/yyyy}"><apex:param value="{!FIR_Qualification_Form__c.ContactName__r.FAQP_Year_Retired__c}"/></apex:outputText>
                                </td>
                                <td>
                                    <span class="lbl">DOB:</span>
                                    <apex:outputText value="{0,date,MM/dd/yyyy}"><apex:param value="{!FIR_Qualification_Form__c.ContactName__r.BirthDate}"/></apex:outputText>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2"><span class="lbl">Retired Peace Officer Type:</span> <apex:outputText value="{!FIR_Qualification_Form__c.ContactName__r.FAQP_Retired_Peace_Officer_Type__c}"/></td>
                            </tr>
                        </table>
                    </div>
                </td>
            </tr>
        </table>
    </apex:outputPanel>

    <table class="grid">
        <thead>
            <tr style="background:#e5e5e5;">
                <th style="width:11%;">Weapon</th>
                <th style="width:17%;">Sight Type</th>
                <th style="width:18%;">Manufacturer &amp; Model</th>
                <th style="width:9%;">Weapon Code</th>
                <th style="width:14%;">Qualified</th>
                <th style="width:14%;">Qualified at 90%</th>
                <th style="width:11%;">Date</th>
            </tr>
        </thead>
        <tbody>
            <apex:repeat value="{!weaponRows}" var="row">
                <tr>
                    <td class="lbl">{!row.weaponLabel}</td>
                    <td>{!row.sightType}</td>
                    <td>{!row.manufacturerModel}</td>
                    <td class="center">{!row.weaponCode}</td>
                    <td class="center">{!row.qualified}</td>
                    <td class="center">{!row.qualifiedAt90}</td>
                    <td class="center">{!row.attemptDate}</td>
                </tr>
            </apex:repeat>
        </tbody>
    </table>

    <br/>
    <br/>

    <table style="width:100%; border-collapse:collapse; margin-top:6px;">
        <tr>
            <td style="width:100%; border:none; padding:0;">

                <apex:outputPanel rendered="{!NOT(FIR_Qualification_Form__c.ContactName__r.Is_Firearms_Instructor__c)}" layout="block">
                    <div style="width:56%;">
                        <div class="name-inline">
                            <span class="lbl">Printed Name of Certified Firearms Instructor:</span>
                            <apex:outputText value="{!FIR_Qualification_Form__c.Firearms_Instrutor__r.Name}"/>
                        </div>
                        <div class="lbl" style="margin-top:5px;">Signature of Certified Firearms Instructor</div>
                        <div class="signature-image">
                            <apex:outputPanel rendered="{!NOT(ISBLANK(instructorSignatureUrl))}" layout="block">
                                <img src="{!instructorSignatureUrl}" alt="Instructor Signature"/>
                            </apex:outputPanel>
                        </div>
                        <div class="lbl" style="margin-top:4px;">Date</div>
                        <div class="date-line">
                            <apex:outputText value="{0,date,MM/dd/yyyy}"><apex:param value="{!FIR_Qualification_Form__c.Test_Date__c}"/></apex:outputText>
                        </div>
                    </div>
                </apex:outputPanel>

                <apex:outputPanel rendered="{!FIR_Qualification_Form__c.ContactName__r.Is_Firearms_Instructor__c}" layout="block">
                    <div style="width:56%;">
                        <div class="name-inline">
                            <span class="lbl">Printed Name of Witness:</span>
                            <apex:outputText value="{!FIR_Qualification_Form__c.Witness_Name__c}"/>
                        </div>
                        <div class="lbl" style="margin-top:5px;">Signature of Witness</div>
                        <div class="signature-image">
                            <apex:outputPanel rendered="{!NOT(ISBLANK(witnessSignatureUrl))}" layout="block">
                                <img src="{!witnessSignatureUrl}" alt="Witness Signature"/>
                            </apex:outputPanel>
                        </div>
                        <div class="lbl" style="margin-top:4px;">Date</div>
                        <div class="date-line">
                            <apex:outputText value="{0,date,MM/dd/yyyy}"><apex:param value="{!FIR_Qualification_Form__c.Witness_Signature_Date__c}"/></apex:outputText>
                        </div>
                    </div>
                </apex:outputPanel>

            </td>
        </tr>
    </table>

    <br/>
    <div class="footer">
        <p>Report Generated on: {!currentCentralDateTime}</p>
    </div>

</body>
</apex:page>