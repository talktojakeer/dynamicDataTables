<apex:page standardController="FIR_Qualification_Form__c"
           extensions="FIRQualificationFormControllerExt"
           sidebar="false" showHeader="false" renderAs="{!IF($CurrentPage.parameters.html == '1', '', 'pdf')}"
           applyBodyTag="false" applyHtmlTag="false">
<head>
<style type="text/css">
    @page { size: A4 portrait; margin: 1.0cm; }
    body, td, th { font-family: Arial, Helvetica, sans-serif; font-size: 8px; line-height: 1.15; color:#000; }
    h1 { font-size: 13px; text-align:center; margin:0; }
    h2 { font-size: 11px; text-align:center; margin:0 0 6px; }
    table.grid { width:100%; border-collapse:collapse; }
    table.grid th, table.grid td { border:1px solid #000; padding:2px 3px; vertical-align:top; }
    .sectionbox { border:1px solid #000; padding:3px 5px; }
    .sectitle { font-weight:bold; text-align:center; background:#e5e5e5; border:1px solid #000; padding:1px; }
    .cb { display:inline-block; width:8px; height:8px; border:1px solid #000; text-align:center; line-height:8px; font-size:8px; font-weight:bold; margin-right:2px; }
    .lbl { font-weight:bold; }
    .nb { border:none; }
    .center { text-align:center; }
    .legend { font-size:6.5px; }
    .sigcell { height:26px; border-bottom:1px solid #000; overflow:hidden; }
    .sig-img { height:40px; border-bottom:1px solid #000; overflow:hidden; }
    .sig-img img { max-height:38px; max-width:100%; display:block; }
</style>
</head>
<body>

    <h1>TEXAS DEPARTMENT OF PUBLIC SAFETY</h1>
    <h2>FIREARMS QUALIFICATION FORM</h2>

    <!-- Full legal name -->
    <div style="margin-bottom:3px;">
        <span class="lbl">Full Legal Name: </span>
        <apex:outputField value="{!FIR_Qualification_Form__c.ContactName__r.Name}"/>
        <span style="color:#555;"> (Last Name, First Name, Middle Name)</span>
    </div>

    <!-- Active Employee | Retired Peace Officer -->
    <table style="width:100%; border-collapse:collapse; margin-bottom:4px;">
        <tr>
            <td style="width:50%; vertical-align:top; padding-right:4px;" class="nb">
                <apex:outputPanel rendered="{!NOT(FIR_Qualification_Form__c.ContactName__r.FAQP_Is_Retired_Officer__c)}">
                <div class="sectitle">Active Employee</div>
                <div class="sectionbox">
                    <div><span class="lbl">Employee TINS #:</span>
                        <apex:outputField value="{!FIR_Qualification_Form__c.ContactName__r.TINS_NUMBER__c}"/></div>
                    <div><span class="lbl">Division:</span>
                        <apex:outputField value="{!FIR_Qualification_Form__c.ContactName__r.FAQP_Division__c}"/>
                        &nbsp;&nbsp;<span class="lbl">Region:</span>
                        <apex:outputField value="{!FIR_Qualification_Form__c.ContactName__r.FAQP_Region__c}"/></div>
                    <div><span class="lbl">Firearms Instructor:</span>
                        <span class="cb">{!IF(FIR_Qualification_Form__c.ContactName__r.Is_Firearms_Instructor__c,'✓','')}</span> Yes
                    </div>
                </div>
                </apex:outputPanel>
            </td>
            <td style="width:50%; vertical-align:top; padding-left:4px;" class="nb">
                <apex:outputPanel rendered="{!FIR_Qualification_Form__c.ContactName__r.FAQP_Is_Retired_Officer__c}">
                <div class="sectitle">Retired Peace Officer</div>
                <div class="sectionbox">
                    <div>
                        <span class="lbl">Year Retired:</span>
                        <apex:outputField value="{!FIR_Qualification_Form__c.ContactName__r.FAQP_Year_Retired__c}"/>
                        &nbsp;&nbsp;<span class="lbl">DOB:</span>
                        <apex:outputField value="{!FIR_Qualification_Form__c.ContactName__r.BirthDate}"/>
                    </div>
                    <apex:variable var="rpt" value="{!FIR_Qualification_Form__c.ContactName__r.Retired_Peace_Officer_Type__c}"/>
                    <div>
                        <span class="cb">{!IF(rpt=='Retired Peace Officer/Non-DPS','✓','')}</span> Retired Peace Officer/Non-DPS
                        &nbsp;<span class="cb">{!IF(rpt=='Special Ranger','✓','')}</span> Special Ranger
                    </div>
                    <div>
                        <span class="cb">{!IF(rpt=='Retired DPS Trooper','✓','')}</span> Retired DPS Trooper
                        &nbsp;<span class="cb">{!IF(rpt=='Special Texas Ranger','✓','')}</span> Special Texas Ranger
                    </div>
                </div>
                </apex:outputPanel>
            </td>
        </tr>
    </table>

    <!-- Light condition -->
    <apex:variable var="lc" value="{!FIR_Qualification_Form__c.Light_Condition__c}"/>
    <div style="margin-bottom:4px;">
        <span class="lbl">Light Condition:</span>
        <span class="cb">{!IF(CONTAINS(lc,'Day'),'✓','')}</span> Daytime/Normal Lighting
        &nbsp;&nbsp;<span class="cb">{!IF(CONTAINS(lc,'Night'),'✓','')}</span> Nighttime/reduced light
    </div>

    <!-- Weapon grid: fixed official rows -->
    <table class="grid">
        <thead>
            <tr style="background:#e5e5e5;">
                <th style="width:11%;">Weapon</th>
                <th style="width:17%;">Sight Type</th>
                <th style="width:18%;">Manufacturer &amp; Model</th>
                <th style="width:9%;">Weapon Code</th>
                <th style="width:13%;">Qualified</th>
                <th style="width:14%;">Qualified at 90%</th>
                <th style="width:11%;">Date</th>
            </tr>
        </thead>
        <tbody>
            <apex:repeat value="{!WeaponRows}" var="r">
                <tr>
                    <td class="lbl">{!r.weaponLabel}</td>
                    <td>
                        <span class="cb">{!r.sightIron}</span> Iron Sight<br/>
                        <span class="cb">{!r.sightOptic}</span> Optic<br/>
                        <span class="cb">{!r.sightMagnified}</span> {!r.sightThirdLabel}
                    </td>
                    <td>{!r.manufacturerModel}</td>
                    <td class="center">{!r.weaponCode}</td>
                    <td class="center">
                        <span class="cb">{!r.qualifiedYes}</span>Yes
                        &nbsp;<span class="cb">{!r.qualifiedNo}</span>No
                    </td>
                    <td class="center">
                        <span class="cb">{!r.qualified90Yes}</span>Yes
                        &nbsp;<span class="cb">{!r.qualified90No}</span>No
                    </td>
                    <td class="center">{!r.attemptDate}</td>
                </tr>
            </apex:repeat>
        </tbody>
    </table>

    <!-- Weapon code legend -->
    <div class="legend" style="margin:3px 0 6px;">
        <span class="lbl">Weapon Code:</span>
        DI &ndash; Department Issue &nbsp;&nbsp; IAT &ndash; In Addition To &nbsp;&nbsp;
        ILO &ndash; In Lieu Of &nbsp;&nbsp; *Magnified Optic: 5x Power or Less &nbsp;&nbsp;
        **Scope: Greater than 5x Power
    </div>

    <!-- Certification + signatures -->
    <div style="margin-top:4px;">
        I certify that the above listed person achieved the minimum qualification score with their weapon(s).
    </div>
    <table style="width:100%; border-collapse:collapse; margin-top:6px;">
        <tr>
            <td style="width:50%; padding-right:8px;" class="nb">
                <div class="lbl">Printed Name of Certified Firearms Instructor</div>
                <div class="sigcell"><apex:outputField value="{!FIR_Qualification_Form__c.Firearms_Instrutor__r.Name}"/></div>
                <div class="lbl" style="margin-top:4px;">Signature of Certified Firearms Instructor</div>
                <div class="sig-img"><apex:outputText escape="false" value="{!FIR_Qualification_Form__c.Firearms_Instructor_Signature__c}"/></div>
                <div class="lbl" style="margin-top:4px;">Date</div>
                <div class="sigcell">
                    <apex:outputText value="{0,date,MM/dd/yyyy}"><apex:param value="{!FIR_Qualification_Form__c.Test_Date__c}"/></apex:outputText>
                </div>
            </td>
            <td style="width:50%; padding-left:8px;" class="nb">
                <apex:outputPanel rendered="{!NOT(ISBLANK(FIR_Qualification_Form__c.Witness_Name__c))}">
                <div class="lbl">Printed Name of Witness (for Firearms Instructors Only)</div>
                <div class="sigcell"><apex:outputField value="{!FIR_Qualification_Form__c.Witness_Name__c}"/></div>
                <div class="lbl" style="margin-top:4px;">Signature of Witness (for Firearms Instructors Only)</div>
                <div class="sig-img"><apex:outputText escape="false" value="{!FIR_Qualification_Form__c.Witness_Signature__c}"/></div>
                <div class="lbl" style="margin-top:4px;">Date</div>
                <div class="sigcell">
                    <apex:outputText value="{0,date,MM/dd/yyyy}"><apex:param value="{!FIR_Qualification_Form__c.Witness_Signature_Date__c}"/></apex:outputText>
                </div>
                </apex:outputPanel>
            </td>
        </tr>
    </table>

    <div style="margin-top:8px; font-size:7px; color:#555;">
        Report Generated on: {!currentCentralDateTime}
    </div>

</body>
</apex:page>
