<apex:page standardController="FIR_Qualification_Form__c"
           extensions="FIRQualificationFormControllerExt"
           sidebar="false" showHeader="false"
           renderAs="{!IF($CurrentPage.parameters.html == '1', '', 'pdf')}"
           applyBodyTag="false" applyHtmlTag="false">
<head>
<style type="text/css">
    @page { size: A4 portrait; margin: 1.0cm; }
    body, td, th { font-family: Arial, Helvetica, sans-serif; font-size: 8px; line-height: 1.15; color:#000; }
    h1 { font-size: 13px; text-align:center; margin:0; font-weight:bold; }
    h2 { font-size: 11px; text-align:center; margin:0 0 6px 0; font-weight:bold; }
    .lbl { font-weight:bold; }
    .center { text-align:center; }
    .legend { font-size:6.5px; }
    .section-table { width:100%; border-collapse:collapse; margin-bottom:4px; }
    .section-table td { vertical-align:top; }
    .sectionbox { border:1px solid #000; padding:4px 6px; min-height:43px; }
    .sectitle { font-weight:bold; text-align:center; background:#e5e5e5; border:1px solid #000; padding:2px; }
    table.grid { width:100%; border-collapse:collapse; }
    table.grid th, table.grid td { border:1px solid #000; padding:2px 3px; vertical-align:top; }
    .name-line { height:24px; border-bottom:1px solid #000; padding-top:2px; }
    .signature-image { width:100%; height:50px; border-bottom:1px solid #000; overflow:hidden; position:relative; }
    .signature-image img { display:block !important; width:auto !important; height:40px !important; max-width:90% !important; max-height:40px !important; margin:0 !important; padding:0 !important; }
    .date-line { height:28px; border-bottom:1px solid #000; padding-top:2px; }
    .right-info-box { border:1px solid #000; margin-bottom:5px; }
    .right-info-title { background:#e5e5e5; border-bottom:1px solid #000; text-align:center; font-weight:bold; padding:1px; }
    .right-info-body { padding:3px 4px; font-size:6.5px; line-height:1.15; }
</style>
</head>
<body>

    <h1>TEXAS DEPARTMENT OF PUBLIC SAFETY</h1>
    <h2>FIREARMS QUALIFICATION FORM</h2>

    <div style="margin-bottom:3px;">
        <span class="lbl">Full Legal Name:</span>
        <apex:outputText value="{!FIR_Qualification_Form__c.ContactName__r.Name}"/>
    </div>

    <apex:outputPanel rendered="{!NOT(FIR_Qualification_Form__c.ContactName__r.FAQP_Is_Retired_Officer__c)}" layout="block">
        <table class="section-table">
            <tr>
                <td style="width:100%;">
                    <div class="sectitle">Active Employee</div>
                    <div class="sectionbox">
                        <div><span class="lbl">Employee TINS #:</span> <apex:outputText value="{!FIR_Qualification_Form__c.ContactName__r.FAQP_TINS_NUMBER__c}"/></div>
                        <div><span class="lbl">Division:</span> <apex:outputText value="{!FIR_Qualification_Form__c.ContactName__r.FAQP_Division__c}"/></div>
                        <div><span class="lbl">Region:</span> <apex:outputText value="{!FIR_Qualification_Form__c.ContactName__r.FAQP_Region__c}"/></div>
                        <div><span class="lbl">Firearms Instructor:</span> <apex:outputText value="{!IF(FIR_Qualification_Form__c.ContactName__r.Is_Firearms_Instructor__c, 'Yes', 'No')}"/></div>
                    </div>
                </td>
            </tr>
        </table>
    </apex:outputPanel>

    <apex:outputPanel rendered="{!FIR_Qualification_Form__c.ContactName__r.FAQP_Is_Retired_Officer__c}" layout="block">
        <table class="section-table">
            <tr>
                <td style="width:100%;">
                    <div class="sectitle">Retired Peace Officer</div>
                    <div class="sectionbox">
                        <div><span class="lbl">Year Retired:</span> <apex:outputText value="{0,date,MM/dd/yyyy}"><apex:param value="{!FIR_Qualification_Form__c.ContactName__r.FAQP_Year_Retired__c}"/></apex:outputText></div>
                        <div><span class="lbl">DOB:</span> <apex:outputText value="{0,date,MM/dd/yyyy}"><apex:param value="{!FIR_Qualification_Form__c.ContactName__r.BirthDate}"/></apex:outputText></div>
                        <div><span class="lbl">Retired Peace Officer Type:</span> <apex:outputText value="{!FIR_Qualification_Form__c.ContactName__r.FAQP_Retired_Peace_Officer_Type__c}"/></div>
                    </div>
                </td>
            </tr>
        </table>
    </apex:outputPanel>

    <div style="margin-bottom:4px;">
        <span class="lbl">Light Condition:</span>
        <apex:outputText value="{!FIR_Qualification_Form__c.Light_Condition__c}"/>
    </div>

    <table class="grid">
        <thead>
            <tr style="background:#e5e5e5;">
                <th style="width:11%;">Weapon</th>
                <th style="width:17%;">Sight Type</th>
                <th style="width:18%;">Manufacturer &amp; Model</th>
                <th style="width:9%;">Weapon Code</th>
                <th style="width:13%;">Qualified</th>
                <th style="width:14%;">Qualified at 90%</th>
                <th style="width:11%;">Date</th>
            </tr>
        </thead>
        <tbody>
            <apex:repeat value="{!WeaponRows}" var="row">
                <tr>
                    <td class="lbl">{!row.weaponLabel}</td>
                    <td>{!row.sightType}</td>
                    <td>{!row.manufacturerModel}</td>
                    <td class="center">{!row.weaponCode}</td>
                    <td class="center">{!row.qualified}</td>
                    <td class="center">{!row.qualifiedAt90}</td>
                    <td class="center">{!row.attemptDate}</td>
                </tr>
            </apex:repeat>
        </tbody>
    </table>

    <div class="legend" style="margin:3px 0 6px;">
        <span class="lbl">Weapon Code:</span>
        DI &ndash; Department Issue &nbsp;&nbsp; IAT &ndash; In Addition To &nbsp;&nbsp;
        ILO &ndash; In Lieu Of &nbsp;&nbsp; *Magnified Optic: 5x Power or Less &nbsp;&nbsp;
        **Scope: Greater than 5x Power
    </div>

    <div style="margin-top:4px;">
        I certify that the above listed person achieved the minimum qualification score with their weapon(s).
    </div>

    <table style="width:100%; border-collapse:collapse; margin-top:6px;">
        <tr>
            <td style="width:100%; border:none; padding:0;">
                <apex:outputPanel rendered="{!NOT(FIR_Qualification_Form__c.ContactName__r.Is_Firearms_Instructor__c)}" layout="block">
                    <div style="width:50%;">
                        <div class="lbl">Printed Name of Certified Firearms Instructor</div>
                        <div class="name-line"><apex:outputText value="{!FIR_Qualification_Form__c.Firearms_Instrutor__r.Name}"/></div>
                        <div class="lbl" style="margin-top:5px;">Signature of Certified Firearms Instructor</div>
                        <div class="signature-image">
                            <apex:outputPanel rendered="{!NOT(ISBLANK(InstructorSignatureUrl))}" layout="block">
                                <img src="{!InstructorSignatureUrl}" alt="Firearms Instructor Signature"/>
                            </apex:outputPanel>
                        </div>
                        <div class="lbl" style="margin-top:4px;">Date</div>
                        <div class="date-line"><apex:outputText value="{0,date,MM/dd/yyyy}"><apex:param value="{!FIR_Qualification_Form__c.Test_Date__c}"/></apex:outputText></div>
                    </div>
                </apex:outputPanel>

                <apex:outputPanel rendered="{!FIR_Qualification_Form__c.ContactName__r.Is_Firearms_Instructor__c}" layout="block">
                    <div style="width:50%;">
                        <div class="lbl">Printed Name of Witness (for Firearms Instructors Only)</div>
                        <div class="name-line"><apex:outputText value="{!FIR_Qualification_Form__c.Witness_Name__c}"/></div>
                        <div class="lbl" style="margin-top:5px;">Signature of Witness (for Firearms Instructors Only)</div>
                        <div class="signature-image">
                            <apex:outputPanel rendered="{!NOT(ISBLANK(WitnessSignatureUrl))}" layout="block">
                                <img src="{!WitnessSignatureUrl}" alt="Witness Signature"/>
                            </apex:outputPanel>
                        </div>
                        <div class="lbl" style="margin-top:4px;">Date</div>
                        <div class="date-line"><apex:outputText value="{0,date,MM/dd/yyyy}"><apex:param value="{!FIR_Qualification_Form__c.Witness_Signature_Date__c}"/></apex:outputText></div>
                    </div>
                </apex:outputPanel>
            </td>
        </tr>
    </table>

    <table style="width:100%; border-collapse:collapse; margin-top:4px;">
        <tr>
            <td style="width:55%; border:none;"></td>
            <td style="width:45%; border:none;">
                <div class="right-info-box">
                    <div class="right-info-title">ACTIVE DPS EMPLOYEE</div>
                    <div class="right-info-body">
                        Firearms instructor retains original qualification form.<br/>
                        Shooter gets a copy of the completed form.<br/>
                        Instructor retains the form according to DPS requirements.
                    </div>
                </div>
                <div class="right-info-box">
                    <div class="right-info-title">RETIRED DPS TROOPER</div>
                    <div class="right-info-body">
                        Firearms instructor retains original qualification form.<br/>
                        Shooter gets a copy of the completed form.<br/>
                        Retired DPS Trooper maintains a copy of the qualification form.
                    </div>
                </div>
                <div class="right-info-box">
                    <div class="right-info-title">SPECIAL RANGER / SPECIAL TEXAS RANGER</div>
                    <div class="right-info-body">
                        Firearms instructor retains original qualification form.<br/>
                        Shooter gets a copy of the completed form.<br/>
                        Maintain documentation as required by DPS.
                    </div>
                </div>
                <div class="right-info-box">
                    <div class="right-info-title">RETIRED PEACE OFFICER / NON-DPS</div>
                    <div class="right-info-body">
                        Firearms instructor retains original qualification form.<br/>
                        Shooter gets a copy of the completed form.<br/>
                        Retired peace officer maintains a copy of the qualification form.
                    </div>
                </div>
            </td>
        </tr>
    </table>

    <div style="margin-top:8px; font-size:7px; color:#555;">
        Report Generated on: {!currentCentralDateTime}
    </div>

</body>
</apex:page>
